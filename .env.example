# PatientFlow environment — copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/patientflow
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=pf_token
COOKIE_SECURE=false
CLIENT_URL=http://localhost:5000
# SMTP (optional). When unset, notifications use the safe dev fallback logger.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PatientFlow <no-reply@patientflow.local>
# Uploads
UPLOAD_MAX_MB=5
UPLOAD_RETENTION_DAYS=90
# Hospital identity
HOSPITAL_NAME=City General Hospital
